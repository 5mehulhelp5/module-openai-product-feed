{
    "name": "angeo/module-openai-product-feed",
    "version": "2.1.1",
    "description": "OpenAI (ChatGPT) product feed generator for Magento 2. Exports a spec-compliant product feed for all product types: simple, virtual, downloadable, configurable, bundle and grouped.",
    "type": "magento2-module",
    "license": "MIT",
    "keywords": [
        "magento2",
        "magento module",
        "openai",
        "chatgpt shopping",
        "agentic commerce",
        "product feed",
        "ai product feed",
        "ecommerce feed",
        "openai integration",
        "product sync",
        "ai ecommerce",
        "feed generation",
        "smart commerce",
        "aeo",
        "angeo"
    ],
    "homepage": "https://angeo.dev/",
    "authors": [
        {
            "name": "Ievgenii Gryshkun",
            "email": "info@angeo.dev",
            "homepage": "https://angeo.dev/"
        }
    ],
    "support": {
        "email": "support@angeo.dev",
        "issues": "https://github.com/angeo-dev/module-openai-product-feed/issues",
        "source": "https://github.com/angeo-dev/module-openai-product-feed"
    },
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": ">=103.0.6 <104",
        "magento/module-backend": ">=102.0.6 <103",
        "magento/module-catalog": ">=104.0.6 <105",
        "magento/module-config": ">=101.2.6 <102",
        "magento/module-configurable-product": ">=100.4.6 <101",
        "magento/module-cron": ">=100.4.6 <101",
        "magento/module-directory": ">=100.4.6 <101",
        "magento/module-eav": ">=102.1.6 <103",
        "magento/module-grouped-product": ">=100.4.6 <101",
        "magento/module-inventory-sales-api": ">=1.2.3 <2",
        "magento/module-store": ">=101.1.6 <102"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "magento/magento-coding-standard": "^40.0 || ^41.0",
        "phpstan/phpstan": "^2.0",
        "bitexpert/phpstan-magento": "^0.43"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Angeo\\OpenAiProductFeed\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Angeo\\OpenAiProductFeed\\Test\\": "Test/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "magento/composer-dependency-version-audit-plugin": false,
            "mage-os/composer-dependency-version-audit-plugin": false,
            "magento/magento-composer-installer": false,
            "magento/inventory-composer-installer": false,
            "laminas/laminas-dependency-plugin": false,
            "php-http/discovery": false
        }
    }
}
